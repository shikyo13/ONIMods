<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyTitle>FastInsulatedSelfSealingAirLock</AssemblyTitle>
    <RootNamespace>FastInsulatedSelfSealingAirLock</RootNamespace>
    <AssemblyVersion>0.3.1.0</AssemblyVersion>
    <FileVersion>0.3.1.0</FileVersion>
    <LangVersion>8.0</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <GameManaged>D:\SteamLibrary\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PLib" Version="4.24.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.40">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameManaged)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameManaged)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>$(GameManaged)\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployMod" AfterTargets="ILRepacking" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ModDeploy>$(USERPROFILE)\Documents\Klei\OxygenNotIncluded\mods\dev\FastInsulatedSelfSealingAirLock\</ModDeploy>
    </PropertyGroup>
    <MakeDir Directories="$(ModDeploy)" />
    <ItemGroup>
      <ModDll Include="$(OutputPath)FastInsulatedSelfSealingAirLock.dll" />
      <ModMeta Include="$(ProjectDir)mod.yaml;$(ProjectDir)mod_info.yaml;$(ProjectDir)config.json" />
      <ModPreview Include="$(ProjectDir)preview.gif" Condition="Exists('$(ProjectDir)preview.gif')" />
      <ModAnim Include="$(ProjectDir)anim\**\*.*" />
      <ModStrings Include="$(ProjectDir)translations\*.po" />
    </ItemGroup>
    <Copy SourceFiles="@(ModDll)" DestinationFolder="$(ModDeploy)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModMeta)" DestinationFolder="$(ModDeploy)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModPreview)" DestinationFolder="$(ModDeploy)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModAnim)" DestinationFiles="@(ModAnim->'$(ModDeploy)anim\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(ModDeploy)translations" Condition="@(ModStrings) != ''" />
    <Copy SourceFiles="@(ModStrings)" DestinationFolder="$(ModDeploy)translations" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed to $(ModDeploy)" />
  </Target>
</Project>
