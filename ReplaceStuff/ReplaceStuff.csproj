<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyTitle>Replace Stuff</AssemblyTitle>
    <Description>One-click replacement for compatible Oxygen Not Included buildings.</Description>
    <Authors>ZeroTheAbsolute</Authors>
    <RootNamespace>ReplaceStuff</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <LangVersion>8.0</LangVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>portable</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <GameManaged Condition="'$(GameManaged)' == ''">D:\SteamLibrary\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PLib" Version="4.24.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.40">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameManaged)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameManaged)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManaged)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManaged)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameManaged)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(GameManaged)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameManaged)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManaged)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(GameManaged)\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="DeployMod" AfterTargets="ILRepacking" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <ModDeploy>$(USERPROFILE)\Documents\Klei\OxygenNotIncluded\mods\dev\ReplaceStuff\</ModDeploy>
    </PropertyGroup>
    <MakeDir Directories="$(ModDeploy)" />
    <ItemGroup>
      <StaleDeployFiles Include="$(ModDeploy)PLib.*" />
      <StaleDeployFiles Include="$(ModDeploy)config.json" />
      <StaleDeployFiles Include="$(ModDeploy)Mod.yaml" />
      <StaleDeployFiles Include="$(ModDeploy)ReplaceStuff.pdb" />
      <StaleDeployFiles Include="$(ModDeploy)workshop-description.*" />
      <ModDll Include="$(OutputPath)ReplaceStuff.dll" />
      <ModMeta Include="$(ProjectDir)mod.yaml;$(ProjectDir)mod_info.yaml;$(ProjectDir)CHANGELOG.txt" />
      <ModPreview Include="$(ProjectDir)preview.png" />
    </ItemGroup>
    <Delete Files="@(StaleDeployFiles)" TreatErrorsAsWarnings="true" />
    <Copy SourceFiles="@(ModDll)" DestinationFolder="$(ModDeploy)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModMeta)" DestinationFolder="$(ModDeploy)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModPreview)" DestinationFolder="$(ModDeploy)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed to $(ModDeploy)" />
  </Target>
</Project>
